# Workforce service
WORKFORCE_PORT=8002

# Local development:
# WORKFORCE_DATABASE_URL=postgresql+psycopg://workforce_user:workforce_pass@localhost:55432/workforce_db

# Docker Compose / Kubernetes:
# Use the database service hostname rather than localhost.
WORKFORCE_DATABASE_URL=postgresql+psycopg://workforce_user:workforce_pass@postgres:5432/workforce_db